# Deployment settings only. No Vobiz account goes here: each agent signs in
# from the softphone with their own account's Auth ID and Auth Token (or with
# an existing SIP endpoint, "SIP direct"), and the backend sets up what that
# account needs at sign-in.

# Local Server Configuration
PORT=8092

# Public HTTPS address of this backend; Vobiz calls <PUBLIC_BASE_URL>/answer.
# Leave unset to use the hostname `npm run tunnel` writes to backend/tunnel-url.txt.
# PUBLIC_BASE_URL=https://calling-bridge.example.com

# Where the per-account endpoint map is kept (ids only, mode 0600).
# DATA_DIR=./backend/data

# Vobiz SIP registrar the softphone registers with; the backend serves it to
# the panel, which uses it for registration and call URIs.
VOBIZ_REGISTRAR=registrar.vobiz.ai

# ServiceNow Instance Configuration (For CDR & Recording Integration)
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_USER=admin
SERVICENOW_PASSWORD=your_instance_admin_password

# Security
# Required by the ServiceNow "Call via Vobiz" button; must match the
# vobiz.calling.shared_secret property. Generate with: openssl rand -hex 32
VOBIZ_SHARED_SECRET=
# Signs recording playback links. Unset, it changes on every restart and every
# link already written into a ServiceNow work note stops working.
SIGNING_SECRET=
# How long a playback link the softphone plays stays valid, in seconds (default 300).
# RECORDING_URL_TTL_SECONDS=300
# How long a recording link written into a ServiceNow record (interaction work
# notes) stays valid, in seconds (default 604800, 7 days).
# RECORD_LINK_TTL_SECONDS=604800
# Extra origins allowed to call this backend, comma-separated. *.service-now.com
# and localhost are always allowed.
# ALLOWED_ORIGINS=
