# Vobiz API Credentials
VOBIZ_AUTH_ID=your_vobiz_auth_id
VOBIZ_AUTH_TOKEN=your_vobiz_auth_token
VOBIZ_FROM_NUMBER=+12345678901   # Must be a number owned by your Vobiz account

# Vobiz SIP WebRTC Endpoint Credentials
VOBIZ_SIP_USER=your_sip_endpoint_username
VOBIZ_SIP_PASSWORD=your_sip_endpoint_password
VOBIZ_REGISTRAR=registrar.vobiz.ai

# Local Server Configuration
PORT=8092

# Optional: Public Tunnel URL override (Cloudflare, ngrok, or reverse proxy)
# TUNNEL_URL=https://your-custom-tunnel.trycloudflare.com

# ServiceNow Instance Configuration (For CDR & Recording Integration)
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_USER=admin
SERVICENOW_PASSWORD=your_instance_admin_password

# Security & Fallback Settings
# Optional shared secret to authenticate incoming /start-call requests from ServiceNow
# VOBIZ_SHARED_SECRET=your_secure_random_shared_secret
# SIGNING_SECRET=your_recording_hmac_signing_secret
DEFAULT_AGENT_ID=admin
